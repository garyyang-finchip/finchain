# Public JSON-RPC entry points for Finchain, served from host B.
# Caddy obtains and renews TLS certificates automatically (ports 80/443 must be reachable
# and the DNS A records for the two hostnames must point at this host).

{
	email {$ACME_EMAIL}
}

{$RPC_HOST} {
	encode gzip
	# Only JSON-RPC over POST is proxied; everything else gets a short status page.
	# handle blocks are mutually exclusive, so the status page cannot shadow the proxy
	# (Caddy orders a bare `respond` before `reverse_proxy`, which made every POST get the page).
	@rpc {
		method POST
		path /
	}
	handle @rpc {
		reverse_proxy op-reth:8545 {
			header_up Host {upstream_hostport}
		}
	}
	handle {
		respond "Finchain Sepolia JSON-RPC. POST JSON-RPC requests to this URL." 200
	}
}

{$WS_HOST} {
	reverse_proxy op-reth:8546
}
