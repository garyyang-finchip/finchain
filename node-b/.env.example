# Host B (verification host) parameters. Copy to node-b/.env.
# Secrets are NOT here: see node-b/secrets/ (created by `make keys` / `make secrets-b`).

# L1 endpoints for THIS host. Use a different provider than host A so that B derives
# Finchain from an independent L1 data source (docs/networking.md).
# Run `make l1-probe` to see which public endpoints answer from this host, or use a
# provider account (Alchemy / Infura / QuickNode) for a dedicated endpoint.
L1_RPC_URL=https://sepolia.gateway.tenderly.co
L1_BEACON_URL=https://ethereum-sepolia-beacon-api.publicnode.com
L1_RPC_KIND=standard
# See node-a/.env.example. For an independent verifier, false with a provider that serves
# eth_getProof at the head is the stronger setting; true is what public endpoints allow.
L1_TRUST_RPC=true

# Public IP of this host (advertised to p2p peers; third-party verifiers dial it later).
P2P_ADVERTISE_IP=203.0.113.10
# Private (tailnet) IP of this host; private RPC ports bind here.
B_BIND_IP=127.0.0.1

# Static peer list for op-node: host A's multiaddr over the private network.
# Example: /ip4/100.64.0.1/tcp/9222/p2p/16Uiu2HAm...
P2P_STATIC_PEERS=

# Transactions received on the public RPC are forwarded to the sequencer's execution client.
SEQUENCER_HTTP=http://100.64.0.1:8545

# L1 contract addresses (filled from chain/out/l1-addresses.json by `make export`).
DISPUTE_GAME_FACTORY=

# Public hostnames served by Caddy (automatic TLS). DNS A records must point here.
RPC_HOST=rpc.finchain.one
WS_HOST=ws.finchain.one
ACME_EMAIL=ops@finchain.one
