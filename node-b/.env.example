# Host B (verification host) parameters. Copy to node-b/.env.
# Secrets are NOT here: see node-b/secrets/ (created by `make keys` / `make secrets-b`).

# L1 endpoints for THIS host. Use a different provider than host A so that B derives
# Finchain from an independent L1 data source (docs/networking.md).
# Run `make l1-probe` to see which public endpoints answer from this host, or use a
# provider account (Alchemy / Infura / QuickNode) for a dedicated endpoint.
L1_RPC_URL=https://sepolia.gateway.tenderly.co
L1_BEACON_URL=https://ethereum-sepolia-beacon-api.publicnode.com
L1_RPC_KIND=standard
# Optional: a separate L1 endpoint for op-challenger (empty = L1_RPC_URL). On every update cycle
# the resident challenger re-reads every game inside its window - about five eth_call per game for
# the bond claimer, ten more per game in progress, plus the game list - and a free public endpoint
# rate-limits that volume (429, measured 2026-11-13 and 2026-11-18; docs/funding-model.md section 5).
# The two settings below cut the volume first; a metered endpoint counts each call inside a batch,
# and the free tiers of the metered providers (about a million calls a month) are below what the
# challenger reads in a day at the upstream defaults. Keep op-node on L1_RPC_URL.
CHALLENGER_L1_RPC_URL=
# Optional: one update cycle per this much L1 time instead of one per L1 block (12 s; upstream
# default 0), and the window of games the challenger tracks and claims bonds for (upstream default
# 672h). 336h is two chess clocks (7 d) plus the 3.5-day finality and withdrawal delays, plus 3.5 d
# of margin. A move or a claim is at most one cycle later than it could be.
#CHALLENGER_MIN_UPDATE_INTERVAL=60s
#CHALLENGER_GAME_WINDOW=336h
# See node-a/.env.example. For an independent verifier, false with a provider that serves
# eth_getProof at the head is the stronger setting; true is what public endpoints allow.
L1_TRUST_RPC=true

# Public IP of this host (advertised to p2p peers; third-party verifiers dial it later).
P2P_ADVERTISE_IP=203.0.113.10
# Private (tailnet) IP of this host; private RPC ports bind here.
B_BIND_IP=127.0.0.1
# Host ports (leave unset for a single chain). A second chain on the same host sets its own,
# e.g. 18545 18546 19001 18547 17300 and p2p 9223; the p2p port is also advertised. Caddy (80/443)
# runs once per host, in the first chain's stack (docs/runbook.md section 9).
#B_RPC_PORT=8545
#B_WS_PORT=8546
#B_RETH_METRICS_PORT=9001
#B_NODE_RPC_PORT=8547
#B_NODE_METRICS_PORT=7300
#B_P2P_PORT=9222

# Static peer list for op-node: host A's multiaddr over the private network.
# Example: /ip4/100.64.0.1/tcp/9222/p2p/16Uiu2HAm...
P2P_STATIC_PEERS=

# Transactions received on the public RPC are forwarded to the sequencer's execution client.
SEQUENCER_HTTP=http://100.64.0.1:8545

# L1 contract addresses (filled from chain/out/l1-addresses.json by `make export`).
DISPUTE_GAME_FACTORY=

# M4 K4, optional: the cannon-kona trace type for the challenger (node-b/docker-compose.kona.yml, applied with
# KONA=1). Defaults are the K2 artifacts under drill/out/ on this host: the Finchain-embedding kona prestate
# (make prestate), the embedded kona-host and the wrapper (make kona-host). Paths are relative to node-b/.
#KONA_L2_CHAIN_ID=85422
#KONA_PRESTATES_DIR=../drill/out/prestates
#KONA_PRESTATE_FILE=0x038b60ac8db81e83cb87229ef9119b500c5723767806cb93a639d70618cad9fb.bin.gz
#KONA_HOST_BIN=../drill/out/bin/kona-host-finchain-kona-client-v1.9.0
#KONA_HOST_WRAPPER=../drill/out/bin/kona-host-wrapper.sh
#KONA_SNAPSHOT_FREQ=100000000

# Public hostnames served by Caddy (automatic TLS). DNS A records must point here.
RPC_HOST=rpc.finchain.one
WS_HOST=ws.finchain.one
ACME_EMAIL=ops@finchain.one
