# Finchain devnet (M4 K3, drill/devnet/README.md): the constants of the isolated environment. Loaded by
# drill/devnet/devnet.sh and by docker compose together with ../../versions.lock (the production images) and
# out/generated.env (what a run derives: addresses, file names). Nothing here is a secret: the accounts are
# anvil's published test accounts, derived from the mnemonic below at run time, and the only chain they ever
# hold funds on is the one anvil invents.

# ---- L1: anvil ---------------------------------------------------------------------------------------------
# The chain id the anvil presents. kona-client (kona-registry l1/mod.rs) and op-node (op-service/eth/config.go)
# carry an L1 configuration for three L1s only: 1, 11155111, 17000. A devnet L1 with any other id makes the
# client fall back to an oracle-supplied L1 configuration, the path the embedded prestate exists to avoid.
# Sepolia's id is the pair of L1 configurations K2 already proved to agree on a real Finchain block.
DEVNET_L1_CHAIN_ID=11155111
DEVNET_L1_BLOCK_TIME=3
# anvil's published test mnemonic; the ten accounts of the devnet (devnet.sh keys)
DEVNET_MNEMONIC="test test test test test test test test test test test junk"
DEVNET_L1_HARDFORK=prague

# ---- L2 ----------------------------------------------------------------------------------------------------
# A chain id of its own so that nothing of the devnet can be mistaken for Finchain Sepolia (85422) or the planned
# mainnet (8454); not registered anywhere, never meant to leave this environment.
DEVNET_L2_CHAIN_ID=854220
DEVNET_CHAIN_NAME="Finchain devnet"
# the registry entry kona-client embeds (drill/kona-configs.sh): a superchain of the devnet's own and its slug
DEVNET_KONA_SUPERCHAIN=finchain-devnet
DEVNET_KONA_SLUG=devnet
# Finchain's parameters (chain/deployer/intent.toml)
DEVNET_EIP1559_DENOMINATOR_CANYON=250
DEVNET_EIP1559_DENOMINATOR=50
DEVNET_EIP1559_ELASTICITY=6
DEVNET_GAS_LIMIT=60000000

# ---- dispute game ------------------------------------------------------------------------------------------
# The game type installed after the deployment: 8 = CANNON_KONA (op-challenger game/types). The factory's shared
# FaultDisputeGame implementation serves it with the devnet prestate in its game arguments (devnet.sh install-game).
DEVNET_GAME_TYPE=8
# 1: the anchor state registry's respected game type becomes 8 as well (the devnet is the only place approved for
# that; on the public chain a Type 8 game may only be a non-default type). 0: type 1 stays respected.
DEVNET_GAME_RESPECTED=1
# The implementation's clocks, set at deployment through op-deployer's globalDeployOverrides (standard value of each
# in the comment). The depths are the standard ones so that the game has the real shape (73 moves to the leaf, the
# standard bond schedule); the clocks are hours instead of days: the honest challenger's chess clock has to cover
# its own cannon runs (one per move below the split depth; drill/devnet/README.md), the clock extension tops it up
# near the end, and the constructor requires max(2 x extension, extension + oracle challenge period) <= max clock
# duration.
# max game depth (standard 73) and split depth (standard 30)
DEVNET_GAME_MAX_DEPTH=73
DEVNET_GAME_SPLIT_DEPTH=30
# clock extension in seconds (standard 10800) and max clock duration (standard 302400)
DEVNET_GAME_CLOCK_EXTENSION=600
DEVNET_GAME_MAX_CLOCK_DURATION=9000
# PreimageOracle large-preimage challenge period (standard 86400)
DEVNET_ORACLE_CHALLENGE_PERIOD=600
# DelayedWETH withdrawal delay (standard 604800), OptimismPortal proof maturity (standard 604800), dispute game
# finality delay (standard 302400)
DEVNET_WITHDRAWAL_DELAY=600
DEVNET_PROOF_MATURITY_DELAY=600
DEVNET_GAME_FINALITY_DELAY=600
# op-proposer: one game every two minutes of the devnet's L1
DEVNET_PROPOSAL_INTERVAL=120s
# op-challenger: a Cannon snapshot every N VM steps. Each move below the split depth re-runs the VM from the nearest
# snapshot, so a lower value trades disk for time (a snapshot is a compressed VM memory image).
DEVNET_SNAPSHOT_FREQ=100000000

# ---- host ports (127.0.0.1 of the scratch host) --------------------------------------------------------------
DEVNET_L1_PORT=18545
DEVNET_SHIM_PORT=18550
DEVNET_L2_PORT=19545
DEVNET_NODE_PORT=19547

# ---- tooling -----------------------------------------------------------------------------------------------
# drill/rpc-shim.py runs in this image inside the devnet (standard library only; the production set in
# versions.lock stays frozen). The digest actually pulled is written into the K3 record.
DEVNET_PYTHON_IMAGE=python:3.12-alpine
