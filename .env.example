# Shared Finchain parameters. Copy to .env and edit. Loaded by the scripts in scripts/.
# Host-specific settings live in node-a/.env and node-b/.env.

# ---- Network identity -------------------------------------------------------
# Candidate chain id. Run `make chain-id-check` and docs/chain-id.md before genesis.
CHAIN_ID=83380
CHAIN_NAME="Finchain Sepolia"
CHAIN_SLUG=finchain-sepolia
DOMAIN=finchain.one

# ---- L1 (Ethereum Sepolia) --------------------------------------------------
L1_CHAIN_ID=11155111
# Execution RPC used by the deployment and verification scripts on this host.
# Host A and host B must each use their own provider (see docs/networking.md).
L1_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Beacon API. Required by op-node and op-challenger even with calldata DA (health check,
# blob retrieval if the DA type is ever switched to blobs).
L1_BEACON_URL=https://ethereum-sepolia-beacon-api.publicnode.com
# op-node --l1.rpckind: standard | basic | alchemy | infura | quicknode | erigon | ...
L1_RPC_KIND=standard

# ---- Governance and fee addresses (externally controlled, no key on any host) ----
# Owner of l1ProxyAdminOwner, l2ProxyAdminOwner and systemConfigOwner roles.
# Leave empty to have `make keys` generate a cold owner key (testnet only, with a warning).
OWNER_ADDRESS=
# Recipient of the four fee vaults (base fee, L1 fee, sequencer fee, operator fee).
# Leave empty to reuse OWNER_ADDRESS.
TREASURY_ADDRESS=

# ---- op-deployer -----------------------------------------------------------
# OP Contracts Manager address on Sepolia for OP_CONTRACTS_TAG (versions.lock).
# Leave empty: `make intent` keeps the value written by `op-deployer init`, or looks it up
# in the superchain-registry standard-versions file when init leaves it blank.
OPCM_ADDRESS=
# Deploy-config overrides applied in standard-overrides mode (JSON object, optional).
# Keep the single quotes; this file is sourced by bash. Example for a shorter testnet
# dispute clock and WETH delay: '{"faultGameMaxClockDuration": 86400, "faultGameWithdrawalDelay": 86400}'
# Key names must match the op-deployer release; see docs/versions.md before using.
DEPLOY_OVERRIDES_JSON=''

# ---- Funding model inputs (docs/funding-model.md) -----------------------------
# Measured values replace these placeholders after M1.
EST_DEPLOY_GAS=40000000
EST_BATCHER_GAS_PER_TX=160000
EST_PROPOSER_GAS_PER_TX=600000
EST_CHALLENGER_GAS_PER_GAME=350000
PLANNED_L2_DEPOSIT_ETH=1.0
