# Profile: lowcost - minimal L1 spend for a quiet public testnet.
# Trade-off: the safe head advances only every 30-60 minutes; FOGA flows that wait for
# `safe` will pause accordingly. State the wait in UI and acceptance records.
PROFILE_NAME=lowcost

# op-batcher: maximum time a channel stays open, in L1 BLOCKS (12 s each).
# 300 blocks = about 1 hour. (Do not confuse with 3600 seconds.)
BATCHER_MAX_CHANNEL_DURATION=300
BATCHER_POLL_INTERVAL=1s
BATCHER_SUB_SAFETY_MARGIN=6

# op-proposer: one output proposal every 6 hours.
PROPOSER_INTERVAL=6h
PROPOSER_POLL_INTERVAL=60s
