# Profile: steady - the standing configuration of the public testnet: batches as in demo, one
# output proposal every 6 hours.
# Trade-off: a withdrawal waits up to 6 hours for a proposal that covers its block. In return
# the resident challenger has a sixth of the games in flight: it reads every game of the
# respected type on every L1 block, and that volume was what a public L1 endpoint rate-limited
# under demo (docs/funding-model.md section 5, docs/proof-plan.md).
PROFILE_NAME=steady

# op-batcher: maximum time a channel stays open, in L1 BLOCKS (12 s each).
# 15 blocks = about 3 minutes between batch submissions on a quiet chain (as in demo).
BATCHER_MAX_CHANNEL_DURATION=15
BATCHER_POLL_INTERVAL=1s
BATCHER_SUB_SAFETY_MARGIN=6

# op-proposer: one output proposal (dispute game) every 6 hours, counted from the latest game.
PROPOSER_INTERVAL=6h
PROPOSER_POLL_INTERVAL=60s
