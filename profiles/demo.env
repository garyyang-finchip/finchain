# Profile: demo - fast L1 publication for integration work and FOGA demonstrations.
# Trade-off: more batcher transactions per day, so more Sepolia ETH.
PROFILE_NAME=demo

# op-batcher: maximum time a channel stays open, in L1 BLOCKS (12 s each).
# 15 blocks = about 3 minutes between batch submissions on a quiet chain.
BATCHER_MAX_CHANNEL_DURATION=15
BATCHER_POLL_INTERVAL=1s
BATCHER_SUB_SAFETY_MARGIN=6

# op-proposer: interval between output proposals (dispute games).
# Determines when a new output root is available for withdrawal proofs.
PROPOSER_INTERVAL=1h
PROPOSER_POLL_INTERVAL=20s
