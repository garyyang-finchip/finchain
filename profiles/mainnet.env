# Finchain mainnet profile (docs/mainnet.md, decision 2 as revised 2026-11-19): the steady profile's
# batching and one output proposal a day, so that about 10.5 games and 0.84 ETH of bonds are in flight
# with mainnet's 3.5-day game clock and 7-day DelayedWETH delay (docs/funding-model.md section 3a).
# Trade-off: a withdrawal waits up to a day for a proposal that covers its block.
PROFILE_NAME=mainnet
# op-batcher: channels close after 15 L1 blocks (about 3 minutes); the same values as steady.
BATCHER_MAX_CHANNEL_DURATION=15
BATCHER_POLL_INTERVAL=1s
BATCHER_SUB_SAFETY_MARGIN=6
# op-proposer: one output proposal (dispute game) every 24 hours, counted from the latest game.
PROPOSER_INTERVAL=24h
PROPOSER_POLL_INTERVAL=60s
