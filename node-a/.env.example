# Host A (sequencing host) parameters. Copy to node-a/.env.
# Secrets are NOT here: see node-a/secrets/ (created by `make keys` / `make secrets-a`).

# L1 endpoints used by op-node, op-batcher and op-proposer on this host.
L1_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
L1_BEACON_URL=https://ethereum-sepolia-beacon-api.publicnode.com
L1_RPC_KIND=standard
# true: op-node reads L1 headers, receipts and the SystemConfig storage without verifying
# them against state roots (eth_getStorageAt instead of eth_getProof). Public endpoints such
# as the Tenderly gateway do not serve eth_getProof at the head ("distance to target block
# exceeds maximum proof window"), so true is required with them. false needs a provider with
# eth_getProof at the head (docs/networking.md).
L1_TRUST_RPC=true

# Address host B (and nothing else) can reach this host on, e.g. the tailnet IP.
# Used to bind the private RPC ports and as the p2p advertise address.
A_BIND_IP=127.0.0.1
P2P_ADVERTISE_IP=127.0.0.1

# Static peer list for op-node (comma-separated multiaddrs). Filled after `make peers`.
# Example: /ip4/100.64.0.2/tcp/9222/p2p/16Uiu2HAm...
P2P_STATIC_PEERS=

# L1 contract addresses (filled from chain/out/l1-addresses.json by `make export`).
DISPUTE_GAME_FACTORY=
# Game type the proposer creates. Read from chain with `make verify-onchain`
# (respected game type), never assumed. 1 = PERMISSIONED_CANNON, 0 = CANNON.
PROPOSER_GAME_TYPE=1
