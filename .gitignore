# Key material and secrets - never commit
keys/*
!keys/.gitkeep
!keys/README.md
node-a/secrets/*
!node-a/secrets/.gitkeep
node-b/secrets/*
!node-b/secrets/.gitkeep
*.pem
*.key
*_pk.txt
jwt.txt
p2p-node-key.txt

# Local environment files (copies of the .env.example files); .env.<chain> for a second chain
.env
.env.*
!.env.example
node-a/.env
node-a/.env.*
!node-a/.env.example
node-b/.env
node-b/.env.*
!node-b/.env.example
node-a/secrets.*/
node-b/secrets.*/
# host-specific Caddy site files (node-b/caddy-sites/README.md); the placeholder and the example are tracked
node-b/caddy-sites/*.caddy
!node-b/caddy-sites/00-default.caddy

# Downloaded binaries and scratch
bin/
tmp/
*.log

# Node data directories if ever mounted locally
data/

# Drill scratch (monorepo checkout, prestates, logs) - docs/proof-plan.md, drill/README.md
drill/work/
drill/out/
# the devnet's keys, deployment, artifacts, logs and snapshots (drill/devnet/README.md)
drill/devnet/out/

# python bytecode (drill/rpc-shim.py)
__pycache__/
*.pyc
